{
  "name": "dsh-metaontic-ai-tool",
  "version": "0.1.0",
  "private": true,
  "description": "基于开源 New API 的 MetaOntic AI 管理工具，支持访问令牌登录与平台查询。",
  "type": "module",
  "license": "UNLICENSED",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "metaontic",
    "new-api",
    "ai-management"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check tests/query.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  }
}
