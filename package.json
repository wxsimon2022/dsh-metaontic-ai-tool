{
  "name": "dsh-metaontic-ai-tool",
  "version": "0.0.10",
  "description": "MetaOntic AI 多模型聚合平台的 DeepSeek Harness 管理插件：访问令牌登录、注册入口、余额与用量查询、API Key 管理、订阅与充值。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxsimon2022/dsh-metaontic-ai-tool.git"
  },
  "homepage": "https://github.com/wxsimon2022/dsh-metaontic-ai-tool#readme",
  "bugs": {
    "url": "https://github.com/wxsimon2022/dsh-metaontic-ai-tool/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "metaontic-ai",
    "metaontic",
    "new-api",
    "model-aggregation",
    "model-gateway",
    "access-token-login",
    "api-key-management",
    "subscription-management",
    "account-dashboard",
    "balance-query",
    "usage-query",
    "ai-management",
    "plugin-market"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/index.js.map",
    "dist/host/**/*.js",
    "dist/host/**/*.d.ts",
    "dist/host/**/*.js.map",
    "dist/client.js",
    "dist/client.js.map",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "esbuild src/client.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=dist/client.js --sourcemap --log-level=warning",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && node --check tests/query.test.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "pack:plugin": "node scripts/pack-plugin.mjs",
    "release:gitee": "node scripts/publish-gitee.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
